#. translators: %s: technical error message
#: src/Api/ApiException.php:60
#, php-format
msgid "VideoOptimizer could not be reached (%s). Please try again in a moment."
msgstr "VideoOptimizer ist nicht erreichbar (%s). Bitte versuchen Sie es gleich noch einmal."

#: src/Api/ApiException.php:63
msgid "The API token is invalid, expired or has been revoked. Please create a new organization token in VideoOptimizer."
msgstr "Das API-Token ist ungültig, abgelaufen oder widerrufen. Bitte erstellen Sie in VideoOptimizer ein neues Organisations-Token."

#. translators: %s: upstream message, e.g. "Video limit of your plan reached"
#: src/Api/ApiException.php:67
#, php-format
msgid "Your VideoOptimizer plan limit has been reached (%s). Please upgrade your plan or delete unused videos."
msgstr "Das Limit Ihres VideoOptimizer-Tarifs ist erreicht (%s). Bitte wechseln Sie den Tarif oder löschen Sie nicht mehr benötigte Videos."

#. translators: %s: upstream message
#: src/Api/ApiException.php:71
#, php-format
msgid "The API token is missing a permission for this action (%s). Use an organization token."
msgstr "Dem API-Token fehlt eine Berechtigung für diese Aktion (%s). Bitte verwenden Sie ein Organisations-Token."

#: src/Api/ApiException.php:74
msgid "The video or library no longer exists in VideoOptimizer."
msgstr "Das Video bzw. die Bibliothek existiert in VideoOptimizer nicht mehr."

#: src/Api/ApiException.php:77
msgid "The file is too large for VideoOptimizer."
msgstr "Die Datei ist für VideoOptimizer zu groß."

#: src/Api/ApiException.php:80
msgid "This file type is not supported."
msgstr "Dieser Dateityp wird nicht unterstützt."

#: src/Api/ApiException.php:83
msgid "Too many requests to VideoOptimizer. Please wait a minute and try again."
msgstr "Zu viele Anfragen an VideoOptimizer. Bitte warten Sie eine Minute und versuchen Sie es erneut."

#: src/Api/ApiException.php:86
msgid "This library is delivery-only (not media-managed) — uploads and poster changes are not possible here."
msgstr "Diese Bibliothek dient nur der Auslieferung (nicht medienverwaltet) – Uploads und Poster-Änderungen sind hier nicht möglich."

#: src/Api/ApiException.php:89
msgid "The VideoOptimizer request failed."
msgstr "Die Anfrage an VideoOptimizer ist fehlgeschlagen."

