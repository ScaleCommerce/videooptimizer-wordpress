{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "videooptimizer/spotlight",
	"version": "0.1.0",
	"title": "VideoOptimizer Spotlight",
	"category": "videooptimizer",
	"description": "A centered headline with a large video and caption.",
	"keywords": [
		"video",
		"spotlight",
		"showcase",
		"lightbox",
		"videooptimizer"
	],
	"textdomain": "videooptimizer",
	"attributes": {
		"uuid": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"headline": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"player": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"hosted",
				"native"
			]
		},
		"presentation": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"facade",
				"lightbox",
				"direct"
			]
		},
		"autoplay": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"muted": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"loop": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"controls": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"priority": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "videooptimizer-frontend"
}
