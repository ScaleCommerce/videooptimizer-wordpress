{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "videooptimizer/video-detail",
	"version": "2.2.0",
	"title": "VideoOptimizer Video Detail",
	"category": "videooptimizer",
	"description": "Shows the video named in the URL (?vo_video=\u2026) with its title and player \u2014 the target of a video list.",
	"keywords": [
		"video",
		"detail",
		"single",
		"player",
		"videooptimizer"
	],
	"textdomain": "videooptimizer",
	"attributes": {
		"uuid": {
			"type": "string",
			"default": ""
		},
		"player": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"hosted",
				"native"
			]
		},
		"presentation": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"facade",
				"lightbox",
				"direct"
			]
		},
		"autoplay": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"muted": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"loop": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"controls": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"1",
				"0"
			]
		},
		"priority": {
			"type": "boolean",
			"default": false
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"libraryId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"left",
			"center",
			"right",
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "videooptimizer-frontend"
}
